<!-- contact-form.html -->
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="wrapper">
                    <div class="row no-gutters">
                        <div class="col-lg-6">
                            <div class="contact-wrap w-100 p-md-5 p-4">
                                <h3>Contact us</h3>
                                <p class="mb-4">We're open for any suggestion or just to have a chat</p>
                                
                                <div id="form-message-warning" class="mb-4" style="display:none; color: #721c24; background-color: #f8d7da; border: 1px solid #f5c6cb; padding: 15px; border-radius: 5px;">
                                    Erro ao enviar. Por favor, tente novamente.
                                </div>
                                <div id="form-message-success" class="mb-4" style="display:none; color: #155724; background-color: #d4edda; border: 1px solid #c3e6cb; padding: 15px; border-radius: 5px;">
                                    Sua mensagem foi enviada com sucesso! Obrigado.
                                </div>

                                <form class="contactForm" id="submit-to-google-sheet" name="submit-to-google-sheet">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <input type="text" class="form-control" name="name" placeholder="Nome" required>
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <input type="email" class="form-control" name="email" placeholder="Email" required>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <select class="form-control" name="subject" required>
                                                    <option value="" disabled selected>Selecione o assunto</option>
                                                    <option value="politica">Estratégia Política (NEXVS)</option>
                                                    <option value="marketing">Estratégia de Marketing (NEXUS°)</option>
                                                    <option value="financas">Estratégia Financeira (NEXUS+)</option>
                                                    <option value="integracao">Integração Completa</option>
                                                    <option value="outro">Outro Assunto</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <textarea class="form-control" name="message" rows="5" placeholder="Mensagem" required></textarea>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <input type="submit" id="submit-btn" value="Enviar Mensagem" class="btn btn-primary">
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="col-lg-6 d-flex align-items-stretch">
                            <div class="info-wrap w-100 p-5 img" style="background-image:url('./assets/contact-image.webp')"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // --- CONFIGURAÇÃO DO COCKPIT ---
    const scriptURL = 'COLE_AQUI_SUA_URL_DO_WEB_APP';
    const form = document.forms['submit-to-google-sheet'];
    const successMsg = document.getElementById('form-message-success');
    const warningMsg = document.getElementById('form-message-warning');
    const btnSubmit = document.getElementById('submit-btn');

    if (form) {
        form.addEventListener('submit', e => {
            e.preventDefault();
            
            // Inicia estado de carregamento
            btnSubmit.value = "Enviando...";
            btnSubmit.disabled = true;
            successMsg.style.display = 'none';
            warningMsg.style.display = 'none';

            fetch(scriptURL, { method: 'POST', body: new FormData(form)})
                .then(response => response.json())
                .then(data => {
                    console.log('Success!', data);
                    successMsg.style.display = 'block';
                    form.reset();
                    btnSubmit.value = "Enviar Mensagem";
                    btnSubmit.disabled = false;
                })
                .catch(error => {
                    console.error('Error!', error.message);
                    warningMsg.style.display = 'block';
                    btnSubmit.value = "Enviar Mensagem";
                    btnSubmit.disabled = false;
                });
        });
    }
</script>
