<!-- contact-form.html - Formulário de Contato NEXUS -->
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="wrapper">
                    <div class="row no-gutters">
                        <div class="col-lg-12">
                            <div class="contact-wrap w-100 p-md-5 p-4">
                                <h3 class="text-center" style="font-family: 'Playfair Display', serif; color: var(--borgonha);">Fale com o NEXUS</h3>
                                <p class="mb-4 text-center">Estamos abertos para sugestões ou apenas para conversar</p>
                                
                                <div id="form-message-warning" class="mb-4" style="display:none; color: #721c24; background-color: #f8d7da; border: 1px solid #f5c6cb; padding: 15px; border-radius: 5px;">
                                    Erro ao enviar. Por favor, tente novamente.
                                </div>
                                <div id="form-message-success" class="mb-4" style="display:none; color: #155724; background-color: #d4edda; border: 1px solid #c3e6cb; padding: 15px; border-radius: 5px;">
                                    Sua mensagem foi enviada com sucesso! Obrigado.
                                </div>

                                <!-- FORMULÁRIO -->
                                <form class="contactForm" id="submit-to-google-sheet" name="submit-to-google-sheet">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <input type="text" class="form-control" name="name" placeholder="Nome" required
                                                       style="width:100%; background:#3c3c44; border:1px solid rgba(255,255,255,0.1); padding:15px; border-radius:12px; color:white;">
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <input type="email" class="form-control" name="email" placeholder="Email" required
                                                       style="width:100%; background:#3c3c44; border:1px solid rgba(255,255,255,0.1); padding:15px; border-radius:12px; color:white;">
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <select class="form-control" name="subject" required
                                                        style="width:100%; background:#3c3c44; border:1px solid rgba(255,255,255,0.1); padding:15px; border-radius:12px; color:white;">
                                                    <option value="" disabled selected style="color:rgba(255,255,255,0.6);">Selecione o assunto</option>
                                                    <option value="politica" style="color:white;">Estratégia Política (NEXVS)</option>
                                                    <option value="marketing" style="color:white;">Estratégia de Marketing (NEXUS°)</option>
                                                    <option value="financas" style="color:white;">Estratégia Financeira (NEXUS+)</option>
                                                    <option value="integracao" style="color:white;">Integração Completa</option>
                                                    <option value="outro" style="color:white;">Outro Assunto</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <textarea class="form-control" name="message" rows="5" placeholder="Mensagem" required
                                                          style="width:100%; background:#3c3c44; border:1px solid rgba(255,255,255,0.1); padding:15px; border-radius:12px; color:white;"></textarea>
                                            </div>
                                        </div>

                                        <div class="col-md-12 text-center">
                                            <div class="form-group">
                                                <input type="submit" id="submit-btn" value="Enviar Mensagem" 
                                                       style="background:var(--gradiente-nexus); color:white; border:none; padding:15px 30px; border-radius:40px; font-weight:600; font-size:1rem; cursor:pointer; transition:all 0.3s; margin-top:20px;">
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SCRIPT DE ENVIO - FICA AQUI NO MESMO ARQUIVO -->
<script>
    (function() {
        // ===== CONFIGURAÇÃO DO GOOGLE APPS SCRIPT =====
        // !! SUBSTITUA PELA SUA URL DO WEB APP !!
        const scriptURL = "https://script.google.com/macros/s/AKfycbyHccJ6bMQqoF2_XIkcOjNGOSOcV8pJ45-Ukh0DYuRXwkVr2GYKAbjgeTcEsxEU3KA47Q/exec";

        
        // Aguarda o DOM carregar
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initForm);
        } else {
            initForm();
        }

        function initForm() {
            const form = document.getElementById('submit-to-google-sheet');
            
            if (!form) {
                console.error('Formulário não encontrado!');
                return;
            }

            const successMsg = document.getElementById('form-message-success');
            const warningMsg = document.getElementById('form-message-warning');
            const btnSubmit = document.getElementById('submit-btn');

            form.addEventListener('submit', e => {
                e.preventDefault();
                
                // Validação básica
                const name = form.querySelector('input[name="name"]').value.trim();
                const email = form.querySelector('input[name="email"]').value.trim();
                const subject = form.querySelector('select[name="subject"]').value;
                const message = form.querySelector('textarea[name="message"]').value.trim();
                
                if (!name || !email || !subject || !message) {
                    warningMsg.style.display = 'block';
                    warningMsg.textContent = 'Por favor, preencha todos os campos.';
                    setTimeout(() => { warningMsg.style.display = 'none'; }, 5000);
                    return;
                }

                // Inicia estado de carregamento
                btnSubmit.value = "Enviando...";
                btnSubmit.disabled = true;
                btnSubmit.style.opacity = "0.7";
                successMsg.style.display = 'none';
                warningMsg.style.display = 'none';

                // Envia para o Google Apps Script
                fetch(scriptURL, { 
                    method: 'POST', 
                    body: new FormData(form),
                    mode: 'no-cors' // Importante para evitar erros de CORS
                })
                .then(() => {
                    // Com no-cors, não conseguimos ler a resposta, mas assumimos sucesso
                    console.log('Formulário enviado com sucesso');
                    
                    // Mostra mensagem de sucesso
                    successMsg.style.display = 'block';
                    
                    // Limpa o formulário
                    form.reset();
                    
                    // Restaura o botão
                    btnSubmit.value = "Enviar Mensagem";
                    btnSubmit.disabled = false;
                    btnSubmit.style.opacity = "1";
                    
                    // Esconde a mensagem após 5 segundos
                    setTimeout(() => {
                        successMsg.style.display = 'none';
                    }, 5000);
                })
                .catch(error => {
                    console.error('Erro:', error);
                    warningMsg.style.display = 'block';
                    warningMsg.textContent = 'Erro ao enviar. Tente novamente.';
                    
                    btnSubmit.value = "Enviar Mensagem";
                    btnSubmit.disabled = false;
                    btnSubmit.style.opacity = "1";
                });
            });
        }
    })();
</script>
